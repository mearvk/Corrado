# Build output
/build/
*.o
*.obj
*.exe
*.out

# Chip dumps / tunes (keep them out of version control by default)
*.bin
!docs/**/*.bin
# ...but DO track our own MIT-licensed reference images (any depth).
!eproms/*_REFERENCE.bin
!eproms/**/*_REFERENCE.bin
# NEVER track real community dumps fetched by fetch-eproms.sh (unlicensed).
/eproms/real/

# Scratch analysis dir
/.analysis/

# Vendored libusb build output (unzipped sources + static lib + staged header).
# The source archive include/libusb-1.0.30.zip IS tracked; its build is not.
/vendor/libusb/staged/

# Fetched third-party CC images (downloaded by images/fetch-images.sh) use
# the manifest's NN_* naming; ignore only those, NOT owner-uploaded photos.
/images/g60/[0-9][0-9]_*.jpg
/images/vr6/[0-9][0-9]_*.jpg
/images/g60/[0-9][0-9]_*.jpeg
/images/vr6/[0-9][0-9]_*.jpeg
/images/g60/[0-9][0-9]_*.png
/images/vr6/[0-9][0-9]_*.png

# Editor / OS cruft
.DS_Store
*.swp
