# Build output
/build/
*.o
*.obj
*.exe
*.out

# Chip dumps / tunes (keep them out of version control by default)
*.bin
!docs/**/*.bin
# ...but DO track our own MIT-licensed reference images (any depth).
!eproms/*_REFERENCE.bin
!eproms/**/*_REFERENCE.bin
# NEVER track real community dumps fetched by fetch-eproms.sh (unlicensed).
/eproms/real/

# Scratch analysis dir
/.analysis/

# Fetched third-party CC images (downloaded by images/fetch-images.sh).
# We keep the manifest/README/script in git, but NOT the binary images.
/images/g60/*.jpg
/images/vr6/*.jpg
/images/g60/*.jpeg
/images/vr6/*.jpeg
/images/g60/*.png
/images/vr6/*.png

# Editor / OS cruft
.DS_Store
*.swp
