# udev rules for the MiniPRO TL866 family used by the Corrado EPROM tool.
#
# Install:
#   sudo cp 60-corrado-tl866.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Then make sure your user is in the 'plugdev' group:
#   sudo usermod -aG plugdev "$USER"   (log out / back in afterwards)

# TL866A / TL866CS (Microchip PIC18F VID)
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="e11c", MODE="0666", GROUP="plugdev"

# TL866II+
SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="0a53", MODE="0666", GROUP="plugdev"
