# udev rules for the MiniPRO / XGecu minipro-family programmers used by the
# Corrado EPROM tool. VID/PIDs match the upstream open-source `minipro` rules.
#
# Install:
#   sudo cp 60-corrado-tl866.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Then make sure your user is in the 'plugdev' group:
#   sudo usermod -aG plugdev "$USER"   (log out / back in afterwards)

# TL866A / TL866CS (Microchip PIC18F VID)
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="e11c", MODE="0666", GROUP="plugdev"

# TL866II+ (XGecu VID)
SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="0a53", MODE="0666", GROUP="plugdev"

# XGecu T48 (TL866-3G)
SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="0001", MODE="0666", GROUP="plugdev"

# XGecu T56
SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="0053", MODE="0666", GROUP="plugdev"

# XGecu T76 (shares the XGecu VID; product id not yet publicly confirmed).
# Uncomment and set the real idProduct once verified, then flip probe=1 for
# the T76 entry in source/corrado_prog.c to enable auto-detection.
#SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="xxxx", MODE="0666", GROUP="plugdev"
